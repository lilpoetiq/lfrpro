# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
#
# --- Recommended: split internal Mac (data) + external volume (uploads) — see EXTERNAL_DATA.md ---
# Run: npm run setup:split   (or: npm run setup:env  for paths only, no file copy)
#
# DATA_DIR  = JSON, catalog.db, checklists, activity logs  (e.g. ~/LFR-assets/data)
# UPLOAD_DIR = album-covers, track-audio, beats, music-videos, audio, …
#              (e.g. /Volumes/Your Drive/LFR-assets when the drive is mounted)
#
# If unset, defaults: ./data and project root for uploads
# On Vercel (VERCEL=1), defaults become /tmp/lfr-data and /tmp/lfr-uploads (ephemeral).
# For persistent production data, use a VPS or set DATA_DIR/UPLOAD_DIR to attached storage.

# --- AI (optional but needed for analysis / some API routes) ---
# OPENAI_API_KEY=

# --- Public site URL (used by some server routes) ---
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Meta / Instagram (optional) ---
# META_APP_ID=
# META_APP_SECRET=

# --- Cron / secured jobs (optional) ---
# CRON_SECRET=

# --- Email (Resend, if used) ---
# RESEND_API_KEY=

# --- Other ---
# AI_SERVER_URL=http://localhost:3001
# NODE_ENV=development
