{
    "name": "lfr-dashboard-project",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "dev:webpack": "next dev --webpack",
        "dev:clean": "rm -rf .next && next dev",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint . --ext .ts,.tsx --max-warnings 999",
        "maintenance:on": "node scripts/maintenance.js on",
        "maintenance:off": "node scripts/maintenance.js off",
        "maintenance:status": "node scripts/maintenance.js status",
        "backfill-vault": "npx tsx scripts/backfill-song-vault.ts",
        "fetch-instagram-metrics": "npx tsx scripts/fetch-instagram-metrics.ts",
        "diagnose": "npx tsx scripts/diagnose.ts",
        "paths": "npx tsx scripts/print-storage-paths.ts",
        "setup:split": "node scripts/setup-split-storage.cjs",
        "setup:env": "node scripts/setup-split-storage.cjs --env-only"
    },
    "dependencies": {
        "@types/archiver": "^7.0.0",
        "@types/bcryptjs": "^2.4.6",
        "archiver": "^7.0.1",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.6.2",
        "clsx": "^2.1.0",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "lucide-react": "^0.303.0",
        "music-metadata": "^11.10.3",
        "next": "^16.1.6",
        "node-id3": "^0.2.9",
        "openai": "^4.20.1",
        "papaparse": "^5.4.1",
        "pdf-parse": "^2.4.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^2.10.3",
        "resend": "^6.8.0",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.10.6",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^18.2.46",
        "@types/react-dom": "^18.2.18",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.0.4",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3"
